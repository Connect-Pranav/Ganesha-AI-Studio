{
  "name": "ganesha-ai-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "validate:data": "node scripts/validate.mjs",
    "agents:gemini": "node scripts/agent-runner.mjs --agent all",
    "test": "node --test --test-concurrency=1 scripts/test.mjs worker/test/orchestrator.test.mjs worker/test/analytics.test.mjs",
    "contracts:gen": "node scripts/gen-contracts.mjs",
    "test:worker": "node --test --test-concurrency=1 worker/test/orchestrator.test.mjs worker/test/analytics.test.mjs",
    "worker:dev": "npm run build && wrangler dev",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22"
  }
}
