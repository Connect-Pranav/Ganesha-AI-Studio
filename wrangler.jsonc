{
  // Cloudflare Worker: static dashboard (dist/) + /api backend (worker/index.mjs).
  // Before deploying this config: create the D1 database and replace database_id
  // (see docs/INTEGRATION_SETUP.md). Secrets are set with `wrangler secret put`, never here.
  "name": "ganesha-studio",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ganesha",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // GANESHA orchestration pass every 5 minutes (Cron Triggers are on the Workers Free plan).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "MAX_CONCURRENT_TASKS": "3",
    "ALLOW_PROVIDER_FALLBACK": "false"
  },
  "observability": { "enabled": true }
}
