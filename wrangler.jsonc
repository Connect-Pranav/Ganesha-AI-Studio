{
  // Cloudflare Worker: static dashboard (dist/) + /api backend (worker/index.mjs).
  // D1 database "ganesha" (id below is an identifier, not a secret).
  // Secrets are set in Cloudflare (ADMIN_TOKEN, GEMINI_API_KEY, ANTHROPIC_API_KEY), never here.
  "name": "ganesha-studio",
  "main": "worker/index.mjs",
  // Keep variables added in the Cloudflare dashboard when Git pushes deploy (prevents keys being wiped).
  "keep_vars": true,
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/m/*", "/t/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ganesha",
      "database_id": "7f947629-c39c-4bcd-94cd-0f7cdf01ff9a",
      "migrations_dir": "migrations"
    }
  ],
  // Reel videos + character sheet images (LittleLoop Reel Factory). No id: Wrangler creates the
  // namespace automatically on the first deploy and keeps the binding after that.
  "kv_namespaces": [{ "binding": "MEDIA" }],
  // GANESHA orchestration pass every 5 minutes (Cron Triggers are on the Workers Free plan).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Free tier first: every agent tries Gemini, then its registry engine(s).
    "PRIMARY_ENGINE": "gemini",
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "MAX_CONCURRENT_TASKS": "3",
    "ALLOW_PROVIDER_FALLBACK": "false",
    // Public origin used for the reel video link Instagram downloads after you approve a reel.
    "PUBLIC_BASE_URL": "https://ganesha-studio.pravanigroup.workers.dev",
    // Instagram API with Instagram Login (secret IG_ACCESS_TOKEN; IG_USER_ID optional, default "me").
    "IG_GRAPH_HOST": "graph.instagram.com",
    "IG_GRAPH_VERSION": "v24.0"
  },
  "observability": { "enabled": true }
}
